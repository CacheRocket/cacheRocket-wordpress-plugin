msgstr "Actes"

msgid "Yes"
msgstr "Oui"

msgid "No"
msgstr "Non"

msgid "Edit"
msgstr "Modifier"

msgid "Disable"
msgstr "Désactiver"

msgid "Enable"
msgstr "Activer"

msgid "Start"
msgstr "Commencer"

msgid "Stop"
msgstr "Arrêt"

msgid "Delete"
msgstr "Supprimer"

msgid "Make your files lighter — minify CSS/JS, defer scripts, and delay JavaScript until interaction for better Core Web Vitals."
msgstr "Allègez vos fichiers : réduisez CSS/JS, différez les scripts et retardez JavaScript jusqu'à l'interaction pour de meilleurs Core Web Vitals."

msgid "CSS files"
msgstr "Fichiers CSS"

msgid "Reduce stylesheet weight and improve font loading."
msgstr "Réduisez le poids de la feuille de style et améliorez le chargement des polices."

msgid "Minify CSS"
msgstr "Réduire le CSS"

msgid "Strip comments and whitespace from inline CSS in the HTML response."
msgstr "Supprimez les commentaires et les espaces du CSS en ligne dans la réponse HTML."

msgid "Optimize Google Fonts"
msgstr "Optimiser les polices Google"

msgid "Add preconnect hints and display=swap for Google Fonts stylesheets."
msgstr "Ajoutez des astuces de préconnexion et display=swap pour les feuilles de style Google Fonts."

msgid "JavaScript files"
msgstr "Fichiers JavaScript"

msgid "Control how scripts load to improve LCP and Interaction to Next Paint."
msgstr "Contrôlez le chargement des scripts pour améliorer le LCP et l’interaction avec Next Paint."

msgid "Minify JavaScript"
msgstr "Réduire JavaScript"

msgid "Strip comments and excess whitespace from inline scripts."
msgstr "Supprimez les commentaires et les espaces inutiles des scripts en ligne."

msgid "Load JavaScript deferred"
msgstr "Chargement JavaScript différé"

msgid "Adds the defer attribute so scripts download in parallel without blocking render. jQuery core is excluded."
msgstr "Ajoute l'attribut defer afin que les scripts soient téléchargés en parallèle sans bloquer le rendu. Le noyau jQuery est exclu."

msgid "Delay JavaScript execution"
msgstr "Retarder l'exécution de JavaScript"

msgid "Hold non-critical scripts until the visitor interacts (or after a short timeout). Strongest for LCP/INP."
msgstr "Conservez les scripts non critiques jusqu'à ce que le visiteur interagisse (ou après un court délai d'attente). Le plus puissant pour LCP/INP."

msgid "Recommended"
msgstr "Recommandé"

msgid "Delay JS exclusions"
msgstr "Retarder les exclusions JS"

msgid "One keyword per line. Matching script handles or URLs are never delayed."
msgstr "Un mot-clé par ligne. Les descripteurs de script ou les URL correspondants ne sont jamais retardés."

msgid "Extras"
msgstr "Suppléments"

msgid "Remove query strings from static resources"
msgstr "Supprimer les chaînes de requête des ressources statiques"

msgid "Strips ?ver= from CSS/JS URLs for better proxy/CDN caching."
msgstr "Supprime ?ver= des URL CSS/JS pour une meilleure mise en cache proxy/CDN."
