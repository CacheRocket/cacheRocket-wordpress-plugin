msgid "Early cache delivery requires WP_CACHE in wp-config.php. Add this line above “That’s all, stop editing!”:"
msgstr "La livraison anticipée du cache nécessite WP_CACHE dans wp-config.php. Ajoutez cette ligne au dessus de « C’est tout, arrêtez d’éditer ! » :"

msgid "Invalid plan response from CacheRocket."
msgstr "Réponse de plan non valide de CacheRocket."

msgid "Warmer name is required."
msgstr "Un nom plus chaleureux est requis."

msgid "At least one entry URL is required."
msgstr "Au moins une URL d’entrée est requise."

msgid "Warmer id is missing."
msgstr "L’identifiant du réchauffeur est manquant."

msgid "CacheRocket drop-in source file is missing."
msgstr "Le fichier source d’insertion CacheRocket est manquant."

msgid "Another advanced-cache.php drop-in is already installed. Remove it before enabling CacheRocket early cache."
msgstr "Un autre drop-in advanced-cache.php est déjà installé. Supprimez-le avant d'activer le cache anticipé de CacheRocket."

msgid "Could not write advanced-cache.php. Check file permissions for wp-content."
msgstr "Impossible d'écrire advanced-cache.php. Vérifiez les autorisations de fichiers pour wp-content."

msgid "CacheRocket page caching is disabled because another cache plugin is active: %s. Deactivate it to use CacheRocket page caching. Cache warming remains available."
msgstr "La mise en cache des pages CacheRocket est désactivée car un autre plugin de cache est actif : %s. Désactivez-le pour utiliser la mise en cache des pages CacheRocket. Le réchauffement du cache reste disponible."

msgid "Could not write .htaccess. Check file permissions."
msgstr "Impossible d'écrire .htaccess. Vérifiez les autorisations des fichiers."

msgid "Failed to update .htaccess rules."
msgstr "Échec de la mise à jour des règles .htaccess."

msgid "Failed to remove .htaccess rules."
msgstr "Échec de la suppression des règles .htaccess."

msgid "WordPress filesystem is not available. Check file permissions."
msgstr "Le système de fichiers WordPress n'est pas disponible. Vérifiez les autorisations des fichiers."

msgid "Could not write the file. Check file permissions."
msgstr "Impossible d'écrire le fichier. Vérifiez les autorisations des fichiers."

msgid "File not found."
msgstr "Fichier introuvable."

msgid "Could not read the file."
msgstr "Impossible de lire le fichier."

msgid "Could not delete the file."
msgstr "Impossible de supprimer le fichier."

msgid "Invalid response from the CacheRocket API."
msgstr "Réponse non valide de l'API CacheRocket."

msgid "CacheRocket API request failed."
msgstr "La requête API CacheRocket a échoué."

msgid "API Key or Secret is missing."
msgstr "La clé API ou le secret est manquant."

msgid "Invalid JSON response from the API."
msgstr "Réponse JSON non valide de l'API."

msgid "No URLs to warm."
msgstr "Aucune URL à réchauffer."

