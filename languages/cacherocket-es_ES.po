msgstr "Detener"

msgid "Delete"
msgstr "Eliminar"

msgid "Make your files lighter — minify CSS/JS, defer scripts, and delay JavaScript until interaction for better Core Web Vitals."
msgstr "Aligere sus archivos: minimice CSS/JS, posponga scripts y retrase JavaScript hasta la interacción para obtener mejores Core Web Vitals."

msgid "CSS files"
msgstr "Archivos CSS"

msgid "Reduce stylesheet weight and improve font loading."
msgstr "Reduzca el peso de las hojas de estilo y mejore la carga de fuentes."

msgid "Minify CSS"
msgstr "Minimizar CSS"

msgid "Strip comments and whitespace from inline CSS in the HTML response."
msgstr "Elimine los comentarios y los espacios en blanco del CSS en línea en la respuesta HTML."

msgid "Optimize Google Fonts"
msgstr "Optimizar las fuentes de Google"

msgid "Add preconnect hints and display=swap for Google Fonts stylesheets."
msgstr "Agregue sugerencias de preconexión y muestre = intercambie hojas de estilo de Google Fonts."

msgid "JavaScript files"
msgstr "archivos javascript"

msgid "Control how scripts load to improve LCP and Interaction to Next Paint."
msgstr "Controle cómo se cargan los scripts para mejorar LCP y la interacción con Next Paint."

msgid "Minify JavaScript"
msgstr "Minimizar JavaScript"

msgid "Strip comments and excess whitespace from inline scripts."
msgstr "Elimine los comentarios y el exceso de espacios en blanco de los scripts en línea."

msgid "Load JavaScript deferred"
msgstr "Cargar JavaScript diferido"

msgid "Adds the defer attribute so scripts download in parallel without blocking render. jQuery core is excluded."
msgstr "Agrega el atributo aplazar para que los scripts se descarguen en paralelo sin bloquear el procesamiento. El núcleo de jQuery está excluido."

msgid "Delay JavaScript execution"
msgstr "Retrasar la ejecución de JavaScript"

msgid "Hold non-critical scripts until the visitor interacts (or after a short timeout). Strongest for LCP/INP."
msgstr "Mantenga los scripts no críticos hasta que el visitante interactúe (o después de un breve tiempo de espera). Más fuerte para LCP/INP."

msgid "Recommended"
msgstr "Recomendado"

msgid "Delay JS exclusions"
msgstr "Retrasar exclusiones de JS"

msgid "One keyword per line. Matching script handles or URLs are never delayed."
msgstr "Una palabra clave por línea. Los identificadores de secuencias de comandos o URL coincidentes nunca se retrasan."

msgid "Extras"
msgstr "Extras"

msgid "Remove query strings from static resources"
msgstr "Eliminar cadenas de consulta de recursos estáticos"

msgid "Strips ?ver= from CSS/JS URLs for better proxy/CDN caching."
msgstr "Elimina ?ver= de las URL CSS/JS para un mejor almacenamiento en caché de proxy/CDN."
