msgid "Early cache delivery requires WP_CACHE in wp-config.php. Add this line above “That’s all, stop editing!”:"
msgstr "La entrega temprana de caché requiere WP_CACHE en wp-config.php. Añade esta línea encima de \"¡Eso es todo, deja de editar!\":"

msgid "Invalid plan response from CacheRocket."
msgstr "Respuesta de plan no válida de CacheRocket."

msgid "Warmer name is required."
msgstr "Se requiere un nombre más cálido."

msgid "At least one entry URL is required."
msgstr "Se requiere al menos una URL de entrada."

msgid "Warmer id is missing."
msgstr "Falta la identificación más cálida."

msgid "CacheRocket drop-in source file is missing."
msgstr "Falta el archivo fuente directo de CacheRocket."

msgid "Another advanced-cache.php drop-in is already installed. Remove it before enabling CacheRocket early cache."
msgstr "Otro complemento avanzado-cache.php ya está instalado. Elimínelo antes de habilitar el caché anticipado de CacheRocket."

msgid "Could not write advanced-cache.php. Check file permissions for wp-content."
msgstr "No se pudo escribir advanced-cache.php. Verifique los permisos de archivo para wp-content."

msgid "CacheRocket page caching is disabled because another cache plugin is active: %s. Deactivate it to use CacheRocket page caching. Cache warming remains available."
msgstr "El almacenamiento en caché de la página CacheRocket está deshabilitado porque hay otro complemento de caché activo: %s. Desactívelo para utilizar el almacenamiento en caché de páginas CacheRocket. El calentamiento de caché sigue estando disponible."

msgid "Could not write .htaccess. Check file permissions."
msgstr "No se pudo escribir .htaccess. Verifique los permisos del archivo."

msgid "Failed to update .htaccess rules."
msgstr "No se pudieron actualizar las reglas de .htaccess."

msgid "Failed to remove .htaccess rules."
msgstr "No se pudieron eliminar las reglas .htaccess."

msgid "WordPress filesystem is not available. Check file permissions."
msgstr "El sistema de archivos de WordPress no está disponible. Verifique los permisos del archivo."

msgid "Could not write the file. Check file permissions."
msgstr "No se pudo escribir el archivo. Verifique los permisos del archivo."

msgid "File not found."
msgstr "Archivo no encontrado."

msgid "Could not read the file."
msgstr "No se pudo leer el archivo."

msgid "Could not delete the file."
msgstr "No se pudo eliminar el archivo."

msgid "Invalid response from the CacheRocket API."
msgstr "Respuesta no válida de la API CacheRocket."

msgid "CacheRocket API request failed."
msgstr "Error en la solicitud de API de CacheRocket."

msgid "API Key or Secret is missing."
msgstr "Falta la clave API o el secreto."

msgid "Invalid JSON response from the API."
msgstr "Respuesta JSON no válida de la API."

msgid "No URLs to warm."
msgstr "No hay URL para calentar."

