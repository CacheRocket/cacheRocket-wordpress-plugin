msgid "Early cache delivery requires WP_CACHE in wp-config.php. Add this line above “That’s all, stop editing!”:"
msgstr "Vroege cache-levering vereist WP_CACHE in wp-config.php. Voeg deze regel toe boven \"Dat is alles, stop met bewerken!\":"

msgid "Invalid plan response from CacheRocket."
msgstr "Ongeldige planreactie van CacheRocket."

msgid "Warmer name is required."
msgstr "Een warmere naam is vereist."

msgid "At least one entry URL is required."
msgstr "Er is minimaal één invoer-URL vereist."

msgid "Warmer id is missing."
msgstr "Warmer-ID ontbreekt."

msgid "CacheRocket drop-in source file is missing."
msgstr "Het CacheRocket drop-in bronbestand ontbreekt."

msgid "Another advanced-cache.php drop-in is already installed. Remove it before enabling CacheRocket early cache."
msgstr "Er is al een andere drop-in voor geavanceerde cache.php geïnstalleerd. Verwijder het voordat u de vroege cache van CacheRocket inschakelt."

msgid "Could not write advanced-cache.php. Check file permissions for wp-content."
msgstr "Kan advanced-cache.php niet schrijven. Controleer de bestandsrechten voor wp-content."

msgid "CacheRocket page caching is disabled because another cache plugin is active: %s. Deactivate it to use CacheRocket page caching. Cache warming remains available."
msgstr "CacheRocket-paginacaching is uitgeschakeld omdat een andere cache-plug-in actief is: %s. Deactiveer het om CacheRocket-paginacaching te gebruiken. Cache-opwarming blijft beschikbaar."

msgid "Could not write .htaccess. Check file permissions."
msgstr "Kon .htaccess niet schrijven. Controleer bestandsrechten."

msgid "Failed to update .htaccess rules."
msgstr "Kan de .htaccess-regels niet updaten."

msgid "Failed to remove .htaccess rules."
msgstr "Kan .htaccess-regels niet verwijderen."

msgid "WordPress filesystem is not available. Check file permissions."
msgstr "WordPress-bestandssysteem is niet beschikbaar. Controleer bestandsrechten."

msgid "Could not write the file. Check file permissions."
msgstr "Kan het bestand niet schrijven. Controleer bestandsrechten."

msgid "File not found."
msgstr "Bestand niet gevonden."

msgid "Could not read the file."
msgstr "Kon het bestand niet lezen."

msgid "Could not delete the file."
msgstr "Kan het bestand niet verwijderen."

msgid "Invalid response from the CacheRocket API."
msgstr "Ongeldig antwoord van de CacheRocket API."

msgid "CacheRocket API request failed."
msgstr "CacheRocket API-verzoek mislukt."

msgid "API Key or Secret is missing."
msgstr "API-sleutel of geheim ontbreekt."

msgid "Invalid JSON response from the API."
msgstr "Ongeldig JSON-antwoord van de API."

msgid "No URLs to warm."
msgstr "Geen URL's om op te warmen."

