msgstr "Open CacheRocket.com"

msgid "See how CacheRocket is accelerating your site — cache, warming, and front-end optimizations in one place."
msgstr "Ontdek hoe CacheRocket uw site versnelt: cache, opwarming en front-end-optimalisaties op één plek."

msgid "Clear cache"
msgstr "Cache wissen"

msgid "Configure cache"
msgstr "Configureer cache"

msgid "Connect your CacheRocket account to unlock remote cache warming and plan features."
msgstr "Verbind uw CacheRocket-account om cache-opwarming op afstand te ontgrendelen en functies te plannen."

