msgid "Early cache delivery requires WP_CACHE in wp-config.php. Add this line above “That’s all, stop editing!”:"
msgstr "Für eine frühe Cache-Bereitstellung ist WP_CACHE in wp-config.php erforderlich. Fügen Sie diese Zeile über „Das ist alles, hören Sie mit der Bearbeitung auf!“ hinzu:"

msgid "Invalid plan response from CacheRocket."
msgstr "Ungültige Planantwort von CacheRocket."

msgid "Warmer name is required."
msgstr "Ein wärmerer Name ist erforderlich."

msgid "At least one entry URL is required."
msgstr "Es ist mindestens eine Eintrags-URL erforderlich."

msgid "Warmer id is missing."
msgstr "Wärmer-ID fehlt."

msgid "CacheRocket drop-in source file is missing."
msgstr "Die CacheRocket-Drop-in-Quelldatei fehlt."

msgid "Another advanced-cache.php drop-in is already installed. Remove it before enabling CacheRocket early cache."
msgstr "Ein weiteres advanced-cache.php-Drop-In ist bereits installiert. Entfernen Sie es, bevor Sie den frühen CacheRocket-Cache aktivieren."

msgid "Could not write advanced-cache.php. Check file permissions for wp-content."
msgstr "advanced-cache.php konnte nicht geschrieben werden. Überprüfen Sie die Dateiberechtigungen für wp-Inhalte."

msgid "CacheRocket page caching is disabled because another cache plugin is active: %s. Deactivate it to use CacheRocket page caching. Cache warming remains available."
msgstr "Das CacheRocket-Seiten-Caching ist deaktiviert, da ein anderes Cache-Plugin aktiv ist: %s. Deaktivieren Sie es, um das CacheRocket-Seiten-Caching zu verwenden. Die Cache-Erwärmung bleibt verfügbar."

msgid "Could not write .htaccess. Check file permissions."
msgstr ".htaccess konnte nicht geschrieben werden. Überprüfen Sie die Dateiberechtigungen."

msgid "Failed to update .htaccess rules."
msgstr "Die Aktualisierung der .htaccess-Regeln ist fehlgeschlagen."

msgid "Failed to remove .htaccess rules."
msgstr "Die .htaccess-Regeln konnten nicht entfernt werden."

msgid "WordPress filesystem is not available. Check file permissions."
msgstr "Das WordPress-Dateisystem ist nicht verfügbar. Überprüfen Sie die Dateiberechtigungen."

msgid "Could not write the file. Check file permissions."
msgstr "Die Datei konnte nicht geschrieben werden. Überprüfen Sie die Dateiberechtigungen."

msgid "File not found."
msgstr "Datei nicht gefunden."

msgid "Could not read the file."
msgstr "Die Datei konnte nicht gelesen werden."

msgid "Could not delete the file."
msgstr "Die Datei konnte nicht gelöscht werden."

msgid "Invalid response from the CacheRocket API."
msgstr "Ungültige Antwort von der CacheRocket-API."

msgid "CacheRocket API request failed."
msgstr "Die CacheRocket-API-Anfrage ist fehlgeschlagen."

msgid "API Key or Secret is missing."
msgstr "API-Schlüssel oder -Geheimnis fehlt."

msgid "Invalid JSON response from the API."
msgstr "Ungültige JSON-Antwort von der API."

msgid "No URLs to warm."
msgstr "Keine URLs zum Aufwärmen."

